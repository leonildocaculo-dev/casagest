# =============================================================================
# MODELO DE CONFIGURACAO — Frontend Next.js
# =============================================================================
# Copiar para .env.local em desenvolvimento. Em producao estas variaveis sao
# definidas no painel da Vercel (Settings -> Environment Variables).
#
# ATENCAO: variaveis NEXT_PUBLIC_* sao substituidas literalmente no bundle
# durante o `next build`, nao sao lidas em runtime. Depois de as alterar na
# Vercel e obrigatorio fazer Redeploy COM A CAIXA "Use existing Build Cache"
# DESMARCADA, caso contrario o valor antigo continua compilado no JavaScript.
# =============================================================================

# URL base da API. Tem de terminar em /api e NAO pode ter barra final:
# src/lib/api.ts e src/lib/utils.ts derivam a raiz do backend com
# .replace(/\/api\/?$/, '') para chegar a /sanctum/csrf-cookie e /storage/...
# O host daqui e tambem o que next.config.ts autoriza no next/image.
# Producao: https://casagest-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Opcional. Definir apenas se as imagens forem servidas do Supabase Storage em
# vez do disco do contentor (que e efemero no Render e perde os uploads a cada
# redeploy). Autoriza o host no next/image.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# --- WebSockets (Laravel Reverb) ---------------------------------------------
# Deixar por definir se o Reverb nao estiver em producao: src/lib/echo.ts cai
# nos defaults de localhost, falha a ligacao e escreve um aviso na consola, mas
# nao bloqueia o resto da aplicacao.
# Em producao a porta e sempre 443 com TLS, nunca 8080.
NEXT_PUBLIC_REVERB_APP_KEY=tgn8tuz4ztntgys7kjib
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
