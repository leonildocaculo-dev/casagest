# =============================================================================
# MODELO DE CONFIGURACAO — pronto para producao
# =============================================================================
# Copiar para .env e preencher os valores vazios. Em producao estas variaveis
# sao definidas no painel do Coolify, nunca num ficheiro no servidor.
#
# Para desenvolvimento local: `docker compose up -d` levanta PostgreSQL, Redis
# e Mailpit com estes mesmos valores. Para depurar, mudar APP_DEBUG para true.
# Os testes usam SQLite em memoria (definido em phpunit.xml) e nao dependem
# deste ficheiro.
# =============================================================================

APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.casagest.caculotech.ao

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de dados -----------------------------------------------------------
# PostgreSQL em desenvolvimento e em producao. SQLite nao serve em producao:
# e um ficheiro em disco, desaparece a cada redeploy em contentor e nao
# suporta escrita concorrente.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=casagest
DB_USERNAME=casagest
DB_PASSWORD=

# Supabase: usar SEMPRE o pooler, nunca db.<ref>.supabase.co. A ligacao directa
# so responde em IPv6 e as plataformas de alojamento partilhado (Render, Fly)
# nao tem saida IPv6 — a ligacao fica em timeout sem erro explicativo.
# Porta 5432 = session pooler (o correcto para PHP-FPM). A 6543 e transaction
# pooler e nao suporta prepared statements, o que parte o Eloquent.
# DB_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail ------------------------------------------------------------------
# Resend: 3.000 mensagens/mes no plano gratuito. Nunca enviar directamente do
# servidor de aplicacao — o IP nao tem reputacao e as mensagens caem em spam.
# Configurar SPF, DKIM e DMARC no DNS antes do primeiro envio real.
# Em desenvolvimento, o docker-compose levanta o Mailpit: mudar MAIL_HOST para
# `mailpit` e MAIL_PORT para 1025.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responder@caculotech.ao"
MAIL_FROM_NAME="${APP_NAME}"

# --- Ficheiros: Cloudflare R2 (compativel com S3) ----------------------------
# O disco `local` guarda ficheiros dentro do contentor e perde-os a cada
# redeploy. O R2 nao cobra saida de dados, o que o torna a escolha certa para
# servir imagens e PDF a partir de Angola.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://<ID_DA_CONTA>.r2.cloudflarestorage.com
AWS_URL=https://ficheiros.caculotech.ao
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# --- Frontend e sessao entre dominios ----------------------------------------
# O frontend corre na Vercel e a API no Render. Sem estas variaveis o navegador
# bloqueia todos os pedidos por CORS.
# Origem exacta do frontend: com esquema, sem barra final. Se ficar por
# definir, config/cors.php fica com a lista de origens VAZIA e a API bloqueia
# todos os pedidos do browser. Aceita varias separadas por virgula.
FRONTEND_URL=https://casagest.vercel.app

# Deploys de preview da Vercel tem um URL diferente a cada commit e nunca
# coincidem com FRONTEND_URL. Expressao regular delimitada, opcional.
# FRONTEND_URL_PATTERN=#^https://casagest-[a-z0-9-]+\.vercel\.app$#

# AUTENTICACAO POR TOKEN (o que esta aplicacao usa)
# ------------------------------------------------
# AuthController devolve um token Sanctum que o frontend guarda em
# localStorage. NAO acrescentar o dominio da Vercel a SANCTUM_STATEFUL_DOMAINS:
# isso torna os pedidos stateful e passa a exigir CSRF em todos os POST/PUT/
# DELETE, com cookies cross-site que o Chrome bloqueia entre .vercel.app e
# .onrender.com de qualquer forma. Deixar a variavel por definir.
# SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
